model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Sales","Dates","Customers","Products","Channels","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Sales
ref table Dates
ref table Customers
ref table Products
ref table Channels
ref table _Measures
ref table _SVG_Measures

ref cultureInfo en-US

